        "body": {
          "mode": "raw",
          "raw": "{\"class_size\":35,\"duration_min\":60,\"session_hour\":10,\"day_of_week\":1,\"subject\":\"Math\",\"grade_level\":9,\"teacher_experience_years\":8,\"attendance_pct\":82.5,\"chat_messages\":28,\"polls_answered\":4,\"hand_raises\":9,\"screen_shares\":2,\"avg_response_sec\":4.2,\"camera_on_pct\":65.0,\"mic_on_pct\":30.0,\"network_drops\":1,\"avg_latency_ms\":65.0,\"reconnects\":0,\"platform\":\"Zoom\",\"quiz_completion\":78.0,\"avg_quiz_score\":72.5,\"assignment_submission_pct\":80.0,\"prev_class_score\":73.0,\"streak_good_sessions\":3}"
        }
